{
  "name": "@codepulse-hud/desktop",
  "version": "1.4.0",
  "private": true,
  "description": "CodePulse HUD Windows desktop app",
  "main": "./out/main/index.js",
  "author": "CodePulse HUD Contributors",
  "homepage": "https://github.com/LBW-C137/CodePulse-HUD",
  "scripts": {
    "predev": "pnpm rebuild:electron",
    "dev": "electron-vite dev",
    "prestart": "pnpm rebuild:electron",
    "start": "electron-vite preview",
    "build": "node scripts/check-device-preview.mjs && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist": "node scripts/check-device-preview.mjs && electron-vite build && electron-builder --win",
    "dist:win": "node scripts/check-device-preview.mjs && electron-vite build && electron-builder --win",
    "dist:dir": "node scripts/check-device-preview.mjs && electron-vite build && electron-builder --dir",
    "rebuild:electron": "electron-builder install-app-deps"
  },
  "dependencies": {
    "serialport": "^13.0.0"
  },
  "devDependencies": {
    "@codepulse/adapters": "workspace:*",
    "@codepulse/core": "workspace:*",
    "@codepulse/local-server": "workspace:*",
    "@codepulse/shared": "workspace:*",
    "@fastify/websocket": "^11.0.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "bonjour-service": "^1.4.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "fastify": "^5.2.1",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11",
    "zustand": "^5.0.2"
  }
}
