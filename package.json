{
  "name": "codepulse-hud",
  "private": true,
  "version": "1.4.0",
  "description": "CodePulse HUD — a local Windows HUD for AI coding agents",
  "license": "MIT",
  "homepage": "https://github.com/LBW-C137/CodePulse-HUD#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LBW-C137/CodePulse-HUD.git"
  },
  "bugs": {
    "url": "https://github.com/LBW-C137/CodePulse-HUD/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @codepulse-hud/desktop dev",
    "build": "pnpm -r --filter ./packages/* build && pnpm --filter @codepulse-hud/desktop build",
    "build:packages": "pnpm -r --filter ./packages/* build",
    "dist": "pnpm --filter @codepulse-hud/desktop dist",
    "dist:win": "pnpm --filter @codepulse-hud/desktop dist:win",
    "icon:generate": "node scripts/generate-app-icon.mjs",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p tests/tsconfig.json",
    "test": "node tests/run-tests.mjs",
    "smoke": "node scripts/run-smoke.mjs",
    "lint": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.21.5",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "ws": "^8.18.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@serialport/bindings-cpp",
      "electron",
      "esbuild"
    ]
  },
  "packageManager": "pnpm@10.19.0"
}
